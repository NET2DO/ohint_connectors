<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ LIST ============================ -->
    <record id="sfa_visit_view_list" model="ir.ui.view">
        <field name="name">sfa.visit.list</field>
        <field name="model">sfa.visit</field>
        <field name="arch" type="xml">
            <list string="Field Visits"
                  decoration-success="within_geofence"
                  decoration-warning="not within_geofence">
                <field name="check_in"/>
                <field name="partner_id"/>
                <field name="salesperson_employee_id" string="Salesperson"/>
                <field name="user_id" string="User" optional="hide"/>
                <field name="purpose"/>
                <field name="outcome"/>
                <field name="distance_m" string="Distance (m)" optional="show"/>
                <field name="geofence_radius_m" string="Radius (m)" optional="hide"/>
                <field name="within_geofence" widget="boolean" string="On-site"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================ FORM ============================ -->
    <record id="sfa_visit_view_form" model="ir.ui.view">
        <field name="name">sfa.visit.form</field>
        <field name="model">sfa.visit</field>
        <field name="arch" type="xml">
            <form string="Field Visit">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id"
                                   placeholder="Customer..."
                                   options="{'no_create': True}"/>
                        </h1>
                    </div>

                    <!-- Geofence verdict badge (computed server-side) -->
                    <div class="oe_button_box" name="geofence_box">
                        <span class="badge text-bg-success fs-6"
                              invisible="not within_geofence">
                            On-site ✓ (within geofence)
                        </span>
                        <span class="badge text-bg-warning fs-6"
                              invisible="within_geofence">
                            Outside geofence ⚠
                        </span>
                    </div>

                    <group>
                        <group string="Visit">
                            <field name="salesperson_employee_id"/>
                            <field name="user_id"/>
                            <field name="purpose"/>
                            <field name="outcome"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Geofence">
                            <field name="distance_m" readonly="1"/>
                            <field name="geofence_radius_m"/>
                            <field name="within_geofence" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Check-in Location">
                            <field name="check_in_latitude"/>
                            <field name="check_in_longitude"/>
                            <field name="check_in_map" widget="url" readonly="1"
                                   text="Open in Google Maps"/>
                        </group>
                        <group string="Check-out Location">
                            <field name="check_out_latitude"/>
                            <field name="check_out_longitude"/>
                            <field name="check_out_map" widget="url" readonly="1"
                                   text="Open in Google Maps"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Visit notes..."/>
                        </page>
                        <page string="Proof" name="proof">
                            <group>
                                <field name="photo" widget="image"
                                       options="{'size': [300, 300]}"/>
                                <field name="signature" widget="signature"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================ SEARCH ============================ -->
    <record id="sfa_visit_view_search" model="ir.ui.view">
        <field name="name">sfa.visit.search</field>
        <field name="model">sfa.visit</field>
        <field name="arch" type="xml">
            <search string="Field Visits">
                <field name="partner_id"/>
                <field name="salesperson_employee_id"/>
                <field name="user_id"/>
                <field name="purpose"/>
                <field name="outcome"/>
                <separator/>
                <filter name="within" string="Within Geofence"
                        domain="[('within_geofence', '=', True)]"/>
                <filter name="outside" string="Outside Geofence"
                        domain="[('within_geofence', '=', False)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('check_in', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('check_in', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_salesperson" string="Salesperson"
                            context="{'group_by': 'salesperson_employee_id'}"/>
                    <filter name="group_customer" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_purpose" string="Purpose"
                            context="{'group_by': 'purpose'}"/>
                    <filter name="group_within" string="Within Geofence"
                            context="{'group_by': 'within_geofence'}"/>
                    <filter name="group_checkin" string="Check-in Date"
                            context="{'group_by': 'check_in'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================ PIVOT ============================ -->
    <record id="sfa_visit_view_pivot" model="ir.ui.view">
        <field name="name">sfa.visit.pivot</field>
        <field name="model">sfa.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits Analysis">
                <field name="salesperson_employee_id" type="row"/>
                <field name="within_geofence" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ============================ GRAPH ============================ -->
    <record id="sfa_visit_view_graph" model="ir.ui.view">
        <field name="name">sfa.visit.graph</field>
        <field name="model">sfa.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits Analysis" type="bar">
                <field name="salesperson_employee_id"/>
                <field name="within_geofence"/>
            </graph>
        </field>
    </record>

    <!-- ================= hr.employee Visits smart button ================= -->
    <record id="hr_employee_view_form_sfa_visit" model="ir.ui.view">
        <field name="name">hr.employee.form.sfa.visit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sfa_visits" type="object"
                        class="oe_stat_button" icon="fa-map-marker">
                    <field name="sfa_visit_count" widget="statinfo" string="Visits"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ============================ ACTIONS ============================ -->
    <record id="sfa_visit_action" model="ir.actions.act_window">
        <field name="name">Field Visits</field>
        <field name="res_model">sfa.visit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sfa_visit_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first field visit</p>
            <p>Record a customer visit. The check-in location is matched against
               the customer's geolocation to prove you were on-site.</p>
        </field>
    </record>

    <record id="sfa_visit_report_action" model="ir.actions.act_window">
        <field name="name">Visits Analysis</field>
        <field name="res_model">sfa.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sfa_visit_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No visits to analyse yet</p>
            <p>Pivot / graph of visits by salesperson, customer and geofence
               compliance.</p>
        </field>
    </record>

    <!-- ============================ MENUS ============================ -->
    <menuitem id="sfa_visit_menu_root"
              name="Field Sales"
              web_icon="n2d_sfa_visit,static/description/icon.png"
              sequence="55"/>
    <menuitem id="sfa_visit_menu_visits"
              name="Visits"
              parent="sfa_visit_menu_root"
              action="sfa_visit_action"
              sequence="10"/>
    <menuitem id="sfa_visit_menu_reporting"
              name="Reporting"
              parent="sfa_visit_menu_root"
              sequence="90"/>
    <menuitem id="sfa_visit_menu_report"
              name="Visits Analysis"
              parent="sfa_visit_menu_reporting"
              action="sfa_visit_report_action"
              sequence="10"/>

</odoo>
