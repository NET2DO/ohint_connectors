<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_activity_dashboard" model="res.groups">
        <field name="name">Activities Dashboard</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Sees every activity in their companies, including those on records they cannot open (private tasks).</field>
    </record>
    <!-- Settings administrators and HR managers get it. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('n2d_ohint_activity.group_activity_dashboard'))]"/>
    </record>
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('n2d_ohint_activity.group_activity_dashboard'))]"/>
    </record>

    <record id="rule_activity_report_company" model="ir.rule">
        <field name="name">Activities Dashboard: own companies</field>
        <field name="model_id" ref="model_ohint_activity_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_activity_done_company" model="ir.rule">
        <field name="name">Completed activities: own companies</field>
        <field name="model_id" ref="model_ohint_activity_done"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
