<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Schedule Activity dialog -->
    <record id="mail_activity_view_form_popup_ohint_employee" model="ir.ui.view">
        <field name="name">mail.activity.form.popup.ohint.employee</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="ohint_employee_id" options="{'no_create': True}"
                       invisible="activity_category == 'meeting'"/>
            </xpath>
        </field>
    </record>

    <!-- Activities list -->
    <record id="mail_activity_view_tree_ohint_employee" model="ir.ui.view">
        <field name="name">mail.activity.list.ohint.employee</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="ohint_employee_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search: find an employee's activities -->
    <record id="mail_activity_view_search_ohint_employee" model="ir.ui.view">
        <field name="name">mail.activity.search.ohint.employee</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_type_id']" position="after">
                <field name="ohint_employee_id"/>
            </xpath>
            <xpath expr="//filter[@name='filter_user_id_uid']" position="after">
                <filter string="Assigned to an employee" name="filter_ohint_employee"
                        domain="[('ohint_employee_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
