<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_sfa" model="ir.ui.view">
        <field name="name">sale.order.form.sfa.identity</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="salesperson_employee_id"/>
            </field>
        </field>
    </record>

    <record id="sale_order_search_sfa" model="ir.ui.view">
        <field name="name">sale.order.search.sfa.identity</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="salesperson" position="after">
                <filter name="sfa_field_salesperson" string="Field Salesperson"
                        context="{'group_by': 'salesperson_employee_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
