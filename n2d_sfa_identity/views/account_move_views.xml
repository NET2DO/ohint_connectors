<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_sfa" model="ir.ui.view">
        <field name="name">account.move.form.sfa.identity</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="salesperson_employee_id"/>
            </field>
        </field>
    </record>

    <record id="account_move_search_sfa" model="ir.ui.view">
        <field name="name">account.move.search.sfa.identity</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="salesperson" position="after">
                <filter name="sfa_field_salesperson" string="Field Salesperson"
                        context="{'group_by': 'salesperson_employee_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
