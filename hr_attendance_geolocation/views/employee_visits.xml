<odoo>
    <data>
        <record id="emp_visits_form_view" model="ir.ui.view">
            <field name="name">emp.visit</field>
            <field name="model">employee.visit</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="check_in"/>
                                <field name="check_out"/>
                                <field name="check_in_map" readonly="1" force_save="1" widget="url"/>
                                <field name="check_out_map" readonly="1" force_save="1" widget="url"/>
                            </group>
                            <group>
                                <field name="location_in" readonly="1" force_save="1"/>
                                <field name="location_out" readonly="1" force_save="1"/>
                                <field name="check_in_latitude" force_save="1"/>
                                <field name="check_in_longitude" force_save="1"/>
                                <field name="check_out_latitude" force_save="1"/>
                                <field name="check_out_longitude" force_save="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="emp_visit_tree" model="ir.ui.view">
            <field name="name">emp.visit</field>
            <field name="model">employee.visit</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="employee_id"/>
                                <field name="check_in"/>
                                <field name="check_out"/>
                     <field name="location_in"/>
                                <field name="location_out"/>
                </tree>
            </field>
        </record>
        <record id="emp_visit_action" model="ir.actions.act_window">
            <field name="name">Employee Visit</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.visit</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                <!-- Add Text Here -->
              </p><p>
                <!-- More details about what a user can do with this object will be OK -->
              </p>
            </field>
        </record>
        <menuitem id="emp_visit_categ" name="Employee Visits"  action="emp_visit_action" sequence="5"/>
    </data>
</odoo>