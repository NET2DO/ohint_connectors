<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define a simple action to replace the gantt view -->
    <record id="action_hr_attendance_gantt_replacement" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance records found
            </p>
            <p>
                The gantt view is not available in this version.
            </p>
        </field>
    </record>

    <!-- Create a menu that uses the replacement action -->
    <record id="menu_hr_attendance_gantt_replacement" model="ir.ui.menu">
        <field name="name">Attendance Gantt</field>
        <field name="action" ref="action_hr_attendance_gantt_replacement"/>
        <field name="sequence" type="int">100</field>
        <field name="parent_id" ref="hr_attendance.menu_hr_attendance_root"/>
    </record>
</odoo>
