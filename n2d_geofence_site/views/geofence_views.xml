<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_location_list" model="ir.ui.view">
        <field name="name">company.location.list.n2d</field>
        <field name="model">company.location</field>
        <field name="arch" type="xml">
            <tree string="Geofence Sites" editable="bottom">
                <field name="name"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="radius"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_company_location_form" model="ir.ui.view">
        <field name="name">company.location.form.n2d</field>
        <field name="model">company.location</field>
        <field name="arch" type="xml">
            <form string="Geofence Site">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                    <group string="Circular Boundary">
                        <field name="latitude"/>
                        <field name="longitude"/>
                        <field name="radius" help="Radius in meters"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_company_location" model="ir.actions.act_window">
        <field name="name">Geofence Sites</field>
        <field name="res_model">company.location</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a geofence site</p>
            <p>Define a circular boundary (latitude, longitude, radius). Assign
               sites to employees and set their Traceable Type to
               "Company Site" so they can only check in/out within the radius.</p>
        </field>
    </record>

    <menuitem id="menu_geofence_root"
              name="Geofencing"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="50"/>
    <menuitem id="menu_geofence_sites"
              name="Geofence Sites"
              parent="menu_geofence_root"
              action="action_company_location"
              sequence="10"/>

</odoo>
